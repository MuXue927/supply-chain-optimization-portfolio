# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors
.idea/
.vscode/
*.iml

# Generated outputs and logs
OutPut*/
outputs/
ExperimentsResults/
logs*/
*.log
*.out
*.tmp

# Solver model dumps. Gurobi and CPLEX write these next to the run output as
# LP / IIS reference files; they are regenerated on every solve and are never
# read back by the code, so they must not be committed.
*.lp
*.ilp
*.mps
*.sav

# Local-only material: kept on disk for the author's reference, never published.
# This holds the CPLEX command-line verification variants and any scratch data
# that are intentionally excluded from the public portfolio.
local-only/

# Raw experiment run outputs. The curated summary tables and figures under
# results/ are committed; the raw per-run directories and logs are not.
results/*/raw/
results/**/raw/

# Ad-hoc CPLEX scratch directories
tmp_cplex_debug/

# Scratch output written by the test suite: the ALNS data loader points its
# output location at <project>/tmp, so running the tests creates it. It is
# regenerated on every run and must never be committed.
tmp/
# Safety net for pytest runs launched without the project's pytest.ini (which
# otherwise places ``pytest-of-<user>/`` in the repository root when the system
# temp directory is not writable).
pytest-of-*/

# Secrets and private data
.env
.env.*
*.pem
*.key
*.crt
*.db
*.sqlite
*.sqlite3
cookies.txt
*cookies*.txt
aws/

# Archives and large local artifacts
*.7z
*.zip
*.tar
*.tar.gz
*.prof

# OS files
.DS_Store
Thumbs.db
